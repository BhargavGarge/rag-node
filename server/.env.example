# GitHub personal access token — raises the API rate limit for repo fetching.
# Works unauthenticated too, but you'll hit 60 req/hr fast.
GITHUB_TOKEN=

# Postgres with the pgvector extension (Supabase / Neon / Render / local).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# https://console.groq.com/keys
GROQ_API_KEY=

# Optional — leave blank to disable request tracing.
AGENTWATCH_API_KEY=
AGENTWATCH_AGENT_ID=
# Optional collector override, e.g. http://localhost:3001 for local dev.
# Unset uses the SDK default (https://api.agentwatch.dev).
AGENTWATCH_ENDPOINT=

PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional tuning
# GROQ_MODEL=llama-3.3-70b-versatile
# TOP_K=8
